---
// src/pages/index.astro
// This file completely replaces App.tsx and acts as your new root route (/)
import '../index.css'; // Import your global Tailwind styles
import Header from '../components/Header';
import CartDrawer from '../components/CartDrawer';
import HomePage from '../components/HomePage';
import Footer from '../components/Footer';
import ProductGrid from '../components/ProductGrid';
import { products, collections } from '../data/products';

// Pre-select product data for client:visible hydration
const featuredProducts = products.filter(p => p.badges.includes('bestseller')).slice(0, 4);
const newArrivals = products.filter(p => p.badges.includes('new')).slice(0, 4);
const limitedEdition = products.filter(p => p.badges.includes('limited')).slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>SURAKURI | Time, Refined.</title>
  </head>
  <body class="bg-ivory text-obsidian min-h-screen">
    <Header client:load />
    <CartDrawer client:load />
    <HomePage client:idle />
    
    <!-- Product Grids hydrated when scrolled into view -->
    <ProductGrid 
      title="The Art of Time" 
      subtitle="Curated Selection" 
      tag="champagne"
      products={featuredProducts}
      viewAllHref="/shop"
      viewAllLabel="View All Timepieces"
      client:visible 
    />
    
    <ProductGrid 
      title="New Arrivals" 
      subtitle="Just Arrived" 
      tag="champagne"
      products={newArrivals}
      viewAllHref="/new-arrivals"
      viewAllLabel="View All New Arrivals"
      bgClass="bg-obsidian text-ivory"
      client:visible 
    />
  </body>
</html>
